    {
      "name": "01 - Reviewer Smoke Flow",
      "item": [
        {
          "name": "Evaluate High Risk Transaction",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{systemIngestorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"event-high-risk-1\",\n  \"transactionId\": \"tx-high-risk-1\",\n  \"customerId\": \"customer-1\",\n  \"accountId\": \"account-1\",\n  \"amount\": 25000.00,\n  \"currency\": \"ZAR\",\n  \"transactionTimestamp\": \"2026-06-07T08:00:00Z\",\n  \"merchantCategory\": \"CRYPTO\",\n  \"country\": \"US\",\n  \"channel\": \"MOBILE\",\n  \"merchantId\": \"MERCHANT-WATCHLIST\",\n  \"merchantName\": \"High Risk Traders\",\n  \"deviceId\": \"device-1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/evaluate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "evaluate"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('high-risk evaluation returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('high-risk transaction is flagged as critical', function () {",
                  "  pm.expect(body.transactionId).to.eql('tx-high-risk-1');",
                  "  pm.expect(body.decision).to.eql('FLAGGED');",
                  "  pm.expect(body.riskLevel).to.eql('CRITICAL');",
                  "  pm.expect(body.riskScore).to.eql(100);",
                  "  pm.expect(body.matchedRules).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.environment.set('transactionId', body.transactionId);",
                  "pm.environment.set('customerId', body.customerId);",
                  "pm.environment.set('accountId', body.accountId);",
                  "pm.environment.set('riskLevel', body.riskLevel);"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit Duplicate Event",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{systemIngestorToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"event-high-risk-1\",\n  \"transactionId\": \"tx-high-risk-1\",\n  \"customerId\": \"customer-1\",\n  \"accountId\": \"account-1\",\n  \"amount\": 25000.00,\n  \"currency\": \"ZAR\",\n  \"transactionTimestamp\": \"2026-06-07T08:00:00Z\",\n  \"merchantCategory\": \"CRYPTO\",\n  \"country\": \"US\",\n  \"channel\": \"MOBILE\",\n  \"merchantId\": \"MERCHANT-WATCHLIST\",\n  \"merchantName\": \"High Risk Traders\",\n  \"deviceId\": \"device-1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/evaluate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "evaluate"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('duplicate event returns deterministic 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('duplicate response is the stored high-risk evaluation', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.transactionId).to.eql(pm.environment.get('transactionId'));",
                  "  pm.expect(body.decision).to.eql('FLAGGED');",
                  "  pm.expect(body.riskLevel).to.eql('CRITICAL');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Fraud Alerts",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{fraudAnalystToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fraud-alerts?customerId={{customerId}}&riskLevel={{riskLevel}}&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fraud-alerts"
              ],
              "query": [
                {
                  "key": "customerId",
                  "value": "{{customerId}}"
                },
                {
                  "key": "riskLevel",
                  "value": "{{riskLevel}}"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('fraud alert list returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const alerts = body.content || [];",
                  "",
                  "pm.test('high-risk alert is returned', function () {",
                  "  pm.expect(body.totalElements).to.be.above(0);",
                  "  pm.expect(alerts.length).to.be.above(0);",
                  "});",
                  "",
                  "const transactionId = pm.environment.get('transactionId');",
                  "const alert = alerts.find((item) => item.transactionId === transactionId) || alerts[0];",
                  "if (alert) {",
                  "  pm.environment.set('alertId', alert.alertId);",
                  "}"
                ]
              }
            }
          ]
        },
