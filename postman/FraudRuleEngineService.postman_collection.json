                "type": "text/javascript",
                "exec": [
                  "pm.test('stored evaluation returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('stored evaluation matches captured transaction', function () {",
